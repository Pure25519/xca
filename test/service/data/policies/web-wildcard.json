{
  "schema": "urn:bxc-pki:schema:policy:v1",
  "id": "web-wildcard",
  "description": "Web servers below example.com, wildcard certificates allowed there, never for the internal subtree; IPv6 documentation network; URIs only on the web hosts; mailboxes at example.com.",
  "names": {
    "dns": {
      "allow": [
        {
          "type": "subtree",
          "value": "example.com",
          "wildcard": true
        }
      ],
      "deny": [
        {
          "type": "subtree",
          "value": "internal.example.com"
        }
      ]
    },
    "ip": {
      "allow": [
        "2001:db8::/32"
      ],
      "deny": [
        "2001:db8:ffff::/48"
      ]
    },
    "uri": {
      "allow": [
        {
          "type": "host-subtree",
          "value": "example.com"
        }
      ]
    },
    "email": {
      "allow": [
        {
          "type": "host",
          "value": "example.com"
        }
      ],
      "deny": [
        {
          "type": "mailbox",
          "value": "root@example.com"
        }
      ]
    },
    "dn": {
      "CN": {
        "deny": [
          {
            "type": "pattern",
            "pattern": ".*[/=].*"
          }
        ]
      }
    }
  }
}
