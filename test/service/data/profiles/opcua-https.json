{
  "schema": "urn:bxc-pki:schema:profile:v1",
  "id": "opcua-https",
  "description": "HTTPS certificate of an OPC UA server (HttpsCertificateType): CN is the DNS name of the HTTPS DiscoveryUrl, O required, dNSName SAN, serverAuth, no URI.",
  "family": "opcua",
  "opc_certificate_type": {
    "rsa": "HttpsCertificateType",
    "ec-p256": "HttpsCertificateType",
    "ec-p384": "HttpsCertificateType"
  },
  "key_source": "csr",
  "key_types": [
    "rsa-2048",
    "rsa-3072",
    "rsa-4096",
    "ec-p256",
    "ec-p384"
  ],
  "ku_by_key_type": {
    "rsa": {
      "bits": [
        "digitalSignature",
        "keyEncipherment"
      ],
      "critical": true
    },
    "ec": {
      "bits": [
        "digitalSignature"
      ],
      "critical": true
    }
  },
  "eku": {
    "purposes": [
      "serverAuth"
    ],
    "critical": false
  },
  "csr_eku": "ignore",
  "csr_basic_constraints": "ignore",
  "csr_aki_ski": "ignore",
  "basic_constraints": {
    "ca": false,
    "critical": true
  },
  "san": {
    "uri": {
      "count": 0
    },
    "dns": {
      "min": 1,
      "max": 4
    },
    "ip": {
      "min": 0,
      "max": 4
    },
    "dns_or_ip_min": 1,
    "keep_csr_order": true,
    "dns_from_cn": false,
    "critical": false
  },
  "subject": {
    "copy": "byte-faithful",
    "required_attributes": [
      "CN",
      "O"
    ],
    "add_missing_o": true,
    "cn_source": "https-host"
  },
  "aki": {
    "form": "key-id"
  },
  "signature": {
    "rsa": {
      "padding": "pkcs1v15",
      "hashes": [
        "sha256",
        "sha384"
      ]
    },
    "ec": {
      "hash_by_curve": {
        "ec-p256": "sha256",
        "ec-p384": "sha384"
      }
    }
  },
  "validity": {
    "default": "P1Y",
    "max": "P2Y",
    "backdate": "PT1H"
  },
  "csr_sha1": "accept-with-warning",
  "keycertsign_request": "override",
  "warnings": []
}
