{
  "schema": "urn:bxc-pki:schema:profile:v1",
  "id": "tls-server-web",
  "description": "TLS server certificate for the web servers of SCALANCE switches and S7 PLCs: RFC 5280 rules only, exactly one dNSName plus an optional IP (more dNSNames only when the name policy allows them), serverAuth, never a URI, never keyEncipherment on EC keys.",
  "family": "tls",
  "key_source": "csr",
  "key_types": [
    "rsa-2048",
    "rsa-3072",
    "rsa-4096",
    "ec-p256",
    "ec-p384"
  ],
  "ku_by_key_type": {
    "rsa": {
      "bits": [
        "digitalSignature",
        "keyEncipherment"
      ],
      "critical": true
    },
    "ec": {
      "bits": [
        "digitalSignature"
      ],
      "critical": true
    }
  },
  "eku": {
    "purposes": [
      "serverAuth"
    ],
    "critical": false
  },
  "csr_eku": "ignore",
  "csr_basic_constraints": "ignore",
  "csr_aki_ski": "ignore",
  "basic_constraints": {
    "ca": false,
    "critical": true
  },
  "san": {
    "uri": {
      "count": 0
    },
    "dns": {
      "min": 1,
      "max": 1
    },
    "ip": {
      "min": 0,
      "max": 1
    },
    "dns_or_ip_min": 1,
    "keep_csr_order": true,
    "dns_from_cn": false,
    "critical": false
  },
  "subject": {
    "copy": "byte-faithful",
    "required_attributes": [
      "CN"
    ],
    "add_missing_o": false,
    "cn_source": "csr"
  },
  "aki": {
    "form": "key-id"
  },
  "signature": {
    "rsa": {
      "padding": "pkcs1v15",
      "hashes": [
        "sha256",
        "sha384"
      ]
    },
    "ec": {
      "hash_by_curve": {
        "ec-p256": "sha256",
        "ec-p384": "sha384"
      }
    }
  },
  "validity": {
    "default": "P1Y",
    "max": "P2Y",
    "backdate": "PT1H"
  },
  "csr_sha1": "accept-with-warning",
  "keycertsign_request": "override",
  "warnings": [
    {
      "id": "scalance-rsa-4096-slow",
      "devices": "SCALANCE XB208",
      "text": "RSA-4096 makes TLS handshakes take 6 to 18 s; use RSA-2048."
    },
    {
      "id": "scalance-ec-firmware",
      "devices": "SCALANCE XB208 V04.01.00 to V04.06.x",
      "text": "EC certificates only from V04.07.00 (P-256/384/521); older firmware falls back to the factory certificate."
    },
    {
      "id": "lpe9403-clock",
      "devices": "SCALANCE LPE9403 V4.0",
      "text": "Device clock about 4 days behind; configure a larger backdate for this device's registration."
    }
  ]
}
