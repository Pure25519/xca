{
  "schema": "urn:bxc-pki:schema:profile:v1",
  "id": "opcua-user",
  "description": "X.509 user identity token for OPC UA (UserCredentialCertificateType): CN is the user name, O required, full RSA key usage because UA-.NETStandard rejects RSA user certificates without dataEncipherment (#1366), clientAuth, no URI.",
  "family": "opcua",
  "opc_certificate_type": {
    "rsa": "UserCredentialCertificateType",
    "ec-p256": "UserCredentialCertificateType",
    "ec-p384": "UserCredentialCertificateType"
  },
  "key_source": "csr",
  "key_types": [
    "rsa-2048",
    "rsa-3072",
    "rsa-4096",
    "ec-p256",
    "ec-p384"
  ],
  "ku_by_key_type": {
    "rsa": {
      "bits": [
        "digitalSignature",
        "nonRepudiation",
        "keyEncipherment",
        "dataEncipherment"
      ],
      "critical": true
    },
    "ec": {
      "bits": [
        "digitalSignature"
      ],
      "optional_bits": [
        "keyAgreement"
      ],
      "critical": true
    }
  },
  "eku": {
    "purposes": [
      "clientAuth"
    ],
    "critical": false
  },
  "csr_eku": "ignore",
  "csr_basic_constraints": "ignore",
  "csr_aki_ski": "ignore",
  "basic_constraints": {
    "ca": false,
    "critical": true
  },
  "san": {
    "uri": {
      "count": 0
    },
    "dns": {
      "min": 0,
      "max": 0
    },
    "ip": {
      "min": 0,
      "max": 0
    },
    "dns_or_ip_min": 0,
    "keep_csr_order": true,
    "dns_from_cn": false,
    "critical": false
  },
  "subject": {
    "copy": "normalized",
    "required_attributes": [
      "CN",
      "O"
    ],
    "add_missing_o": true,
    "cn_source": "user"
  },
  "aki": {
    "form": "key-id"
  },
  "signature": {
    "rsa": {
      "padding": "pkcs1v15",
      "hashes": [
        "sha256",
        "sha384"
      ]
    },
    "ec": {
      "hash_by_curve": {
        "ec-p256": "sha256",
        "ec-p384": "sha384"
      }
    }
  },
  "validity": {
    "default": "P1Y",
    "max": "P2Y",
    "backdate": "PT1H"
  },
  "csr_sha1": "reject",
  "keycertsign_request": "reject",
  "warnings": []
}
