{
  "schema": "urn:bxc-pki:schema:profile:v1.1",
  "id": "xca-tls-server",
  "description": "XCA default templates TLS_server (misc/TLS_server.xca, RSA keys) and TLS_server_EC (misc/TLS_server_EC.xca, EC keys), with the key usage by key type of BTD-195 (BTD-203): digitalSignature, nonRepudiation, keyEncipherment for RSA, digitalSignature, nonRepudiation for EC; serverAuth, the CN as dNSName (DNS:copycn), 365 days.",
  "family": "generic",
  "key_source": "csr",
  "key_types": [
    "rsa-2048",
    "rsa-3072",
    "rsa-4096",
    "ec-p256",
    "ec-p384"
  ],
  "ku_by_key_type": {
    "rsa": {
      "bits": [
        "digitalSignature",
        "nonRepudiation",
        "keyEncipherment"
      ],
      "critical": false
    },
    "ec": {
      "bits": [
        "digitalSignature",
        "nonRepudiation"
      ],
      "critical": false
    }
  },
  "eku": {
    "purposes": [
      "serverAuth"
    ],
    "critical": false
  },
  "csr_eku": "ignore",
  "csr_basic_constraints": "ignore",
  "csr_aki_ski": "ignore",
  "basic_constraints": {
    "ca": false,
    "critical": true
  },
  "san": {
    "uri": {
      "count": 0
    },
    "dns": {
      "min": 0,
      "max": 4
    },
    "ip": {
      "min": 0,
      "max": 4
    },
    "dns_or_ip_min": 0,
    "keep_csr_order": true,
    "dns_from_cn": true,
    "critical": false
  },
  "subject": {
    "copy": "byte-faithful",
    "required_attributes": [
      "CN"
    ],
    "add_missing_o": false,
    "cn_source": "csr"
  },
  "aki": {
    "form": "key-id"
  },
  "signature": {
    "rsa": {
      "padding": "pkcs1v15",
      "hashes": [
        "sha256",
        "sha384"
      ]
    },
    "ec": {
      "hash_by_curve": {
        "ec-p256": "sha256",
        "ec-p384": "sha384"
      }
    }
  },
  "validity": {
    "default": "P365D",
    "max": "P365D",
    "backdate": "PT0S"
  },
  "csr_sha1": "reject",
  "keycertsign_request": "reject",
  "warnings": []
}
