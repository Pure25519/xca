{
  "schema": "urn:bxc-pki:schema:profile:v1",
  "id": "opcua-server-keygen",
  "description": "Variant of opcua-server with the key generated by bxc-pki, for devices without a CSR path (EST serverkeygen; packaging in BTD-66). Everything else equals opcua-server.",
  "family": "opcua",
  "opc_certificate_type": {
    "rsa": "RsaSha256ApplicationCertificateType",
    "ec-p256": "EccNistP256ApplicationCertificateType",
    "ec-p384": "EccNistP384ApplicationCertificateType"
  },
  "key_source": "server",
  "base_profile": "opcua-server",
  "key_types": [
    "rsa-2048",
    "rsa-3072",
    "rsa-4096",
    "ec-p256",
    "ec-p384"
  ],
  "ku_by_key_type": {
    "rsa": {
      "bits": [
        "digitalSignature",
        "nonRepudiation",
        "keyEncipherment",
        "dataEncipherment"
      ],
      "critical": true
    },
    "ec": {
      "bits": [
        "digitalSignature"
      ],
      "optional_bits": [
        "keyAgreement"
      ],
      "critical": true
    }
  },
  "eku": {
    "purposes": [
      "serverAuth",
      "clientAuth"
    ],
    "critical": true
  },
  "csr_eku": "ignore",
  "csr_basic_constraints": "ignore",
  "csr_aki_ski": "ignore",
  "basic_constraints": {
    "ca": false,
    "critical": true
  },
  "san": {
    "uri": {
      "count": 1,
      "source": "registration"
    },
    "dns": {
      "min": 0,
      "max": 4
    },
    "ip": {
      "min": 0,
      "max": 4
    },
    "dns_or_ip_min": 1,
    "keep_csr_order": true,
    "dns_from_cn": false,
    "critical": false
  },
  "subject": {
    "copy": "byte-faithful",
    "required_attributes": [
      "CN"
    ],
    "add_missing_o": false,
    "cn_source": "csr",
    "forbidden_characters": [
      {
        "device_class": "S7-1500 V02.09.08/V02.09.09",
        "characters": "/=",
        "reference": "accepted in the CSR but brick the device on apply (IDIAL device_profiles, SMP-172)"
      }
    ]
  },
  "aki": {
    "form": "key-id"
  },
  "signature": {
    "rsa": {
      "padding": "pkcs1v15",
      "hashes": [
        "sha256",
        "sha384"
      ]
    },
    "ec": {
      "hash_by_curve": {
        "ec-p256": "sha256",
        "ec-p384": "sha384"
      }
    }
  },
  "validity": {
    "default": "P1Y",
    "max": "P2Y",
    "backdate": "PT1H"
  },
  "csr_sha1": "accept-with-warning",
  "keycertsign_request": "override",
  "crl_size_budget": 4096,
  "warnings": [
    {
      "id": "s7-1500-rsa-4096-slow",
      "devices": "Siemens S7-1500",
      "text": "With an RSA-4096 key the OPC UA session setup takes 8.8 to 15.2 s; S7 creates only RSA-2048 keys itself, V02.09.07 refuses a new request while a non-2048 key is installed.",
      "references": [
        "SMP-828",
        "SMP-837"
      ]
    }
  ]
}
