# bxc-pki revoke (BTD-42, rule 8 of PLAN.md 8.4) with a password-protected
# CA key: by name, by serial (hex with and without colons, decimal), by
# SHA-256 fingerprint; an ambiguous name lists the candidates; a missing
# reason, an unknown serial, a wrong issuer and a second revocation are
# refused; every revocation issues the CRL of the CA at once, the CRL of
# the crl command lists the serials (openssl crl -text); the CRL numbers
# increase over init, revoke and crl runs; --plan writes nothing; audit
# entries with channel cli.

include("${LIB}")

function(revoked_type ref var)
  bxc("show ${ref}" 0 show "${ref}" --db "${DB}" ${PW} --type certificate)
  string(STRIP "${out}" d)
  string(JSON t TYPE "${d}" revocation)
  set(${var} "${t}" PARENT_SCOPE)
endfunction()

set(numbers "")
macro(crl_number_of doc)
  crl_entry("${doc}" 0 _c)
  string(JSON _n GET "${_c}" crl_number)
  list(APPEND numbers ${_n})
endmacro()

# --- CA with a key of its own password -----------------------------------
bxc("init" 0 init --db "${DB}" ${PW} --cn "Rev Root" --key ec-p256)
one_doc("init" "${out}" cli-result r)
result_objects("${r}" objs)
if(NOT objs STREQUAL "key:Rev Root;certificate:Rev Root;crl:Rev Root")
  fail("init wrote '${objs}', expected key, certificate and the empty CRL")
endif()
crl_number_of("${r}")
fixture("CA key with its own password" ownpass "Rev Root")
bxc("show key" 0 show "Rev Root" --db "${DB}" ${PW} --type key)
string(STRIP "${out}" k)
string(JSON prot GET "${k}" protection)
if(NOT prot STREQUAL "own")
  fail("the CA key is not protected by its own password: '${prot}'")
endif()
bxc("other root" 0 init --db "${DB}" ${PW} --cn "Other Root" --key ec-p256)

foreach(n dev1 dev2 dev3 dev4 dev5)
  bxc("request ${n}" 0 request-cert --db "${DB}" ${PW} --cn ${n})
  bxc("sign ${n}" 0 sign ${n} --db "${DB}" ${PW} --ca "Rev Root")
  one_doc("sign ${n}" "${out}" cli-result r)
  object_doc("${r}" certificate c)
  string(JSON serial_${n} GET "${c}" serial)
  string(JSON fp_${n} GET "${c}" fingerprints sha256)
  string(JSON id_${n} GET "${c}" id)
endforeach()
set(twin_ids "")
foreach(i 1 2)
  bxc("request twin ${i}" 0 request-cert --db "${DB}" ${PW} --cn twin)
  one_doc("request twin" "${out}" cli-result r)
  object_doc("${r}" request q)
  string(JSON qid GET "${q}" id)
  bxc("sign twin ${i}" 0 sign ${qid} --db "${DB}" ${PW} --ca "Rev Root")
  one_doc("sign twin" "${out}" cli-result r)
  object_doc("${r}" certificate c)
  string(JSON cid GET "${c}" id)
  list(APPEND twin_ids ${cid})
endforeach()

# --- refusals --------------------------------------------------------------
bxc("no reason" 2 revoke dev1 --db "${DB}" ${PW})
expect_error("no reason" missing_option)
bxc("bad reason" 2 revoke dev1 --db "${DB}" ${PW} --reason stolen)
expect_error("bad reason" invalid_reason)
bxc("delta reason" 2 revoke dev1 --db "${DB}" ${PW} --reason removeFromCRL)
expect_error("delta reason" invalid_reason)
bxc("no selector" 2 revoke --db "${DB}" ${PW} --reason keyCompromise)
expect_error("no selector" missing_argument)
bxc("two selectors" 2 revoke dev1 --db "${DB}" ${PW} --reason keyCompromise
    --serial 01)
expect_error("two selectors" conflicting_options)
bxc("serial without --ca" 2 revoke --db "${DB}" ${PW} --reason keyCompromise
    --serial 01)
expect_error("serial without --ca" missing_option)
bxc("ambiguous name" 1 revoke twin --db "${DB}" ${PW} --reason superseded)
expect_error("ambiguous name" ambiguous_reference)
foreach(id IN LISTS twin_ids)
  if(NOT detail MATCHES "certificate ${id} 'twin'")
    fail("ambiguous name: candidate ${id} missing in '${detail}'")
  endif()
endforeach()
bxc("unknown serial" 1 revoke --db "${DB}" ${PW} --reason keyCompromise
    --serial 0xDEADBEEF01 --ca "Rev Root")
expect_error("unknown serial" unknown_serial)
bxc("wrong issuer" 1 revoke dev1 --db "${DB}" ${PW} --reason keyCompromise
    --ca "Other Root")
expect_error("wrong issuer" wrong_issuer)
bxc("serial of another issuer" 1 revoke --db "${DB}" ${PW}
    --reason keyCompromise --serial ${serial_dev1} --ca "Other Root")
expect_error("serial of another issuer" unknown_serial)
bxc("bad fingerprint" 2 revoke --db "${DB}" ${PW} --reason keyCompromise
    --fingerprint 12:34)
expect_error("bad fingerprint" invalid_fingerprint)
# the CA key cannot be unlocked without a password: nothing is revoked
bxc("no password" 1 revoke dev1 --db "${DB}" --reason keyCompromise)
expect_error("no password" missing_password)
revoked_type(dev1 t)
if(NOT t STREQUAL "NULL")
  fail("dev1 was revoked by a failed run")
endif()

# --- --plan --------------------------------------------------------------
count_items(crl crls_before)
bxc("plan" 0 revoke dev5 --db "${DB}" ${PW} --reason keyCompromise --plan)
one_doc("plan" "${out}" cli-result r)
result_objects("${r}" objs)
if(NOT objs STREQUAL "crl:Rev Root")
  fail("plan: objects '${objs}'")
endif()
string(JSON t TYPE "${r}" objects 0 id)
if(NOT t STREQUAL "NULL")
  fail("plan: a CRL id in the result")
endif()
count_items(crl crls_after)
revoked_type(dev5 t)
if(NOT crls_before EQUAL crls_after OR NOT t STREQUAL "NULL")
  fail("plan wrote something (CRLs ${crls_before} -> ${crls_after}, dev5 ${t})")
endif()

# --- revocations ---------------------------------------------------------
bxc("by name" 0 revoke dev1 --db "${DB}" ${PW} --reason keyCompromise)
one_doc("by name" "${out}" cli-result r)
string(JSON reason GET "${r}" revocation reason)
string(JSON rs GET "${r}" revocation serial)
if(NOT reason STREQUAL "keyCompromise" OR NOT rs STREQUAL serial_dev1)
  fail("by name: revocation ${reason} ${rs}")
endif()
result_objects("${r}" objs)
if(NOT objs STREQUAL "crl:Rev Root")
  fail("revoke must issue the CRL of the CA: '${objs}'")
endif()
crl_entry("${r}" 0 c)
string(JSON trig GET "${c}" trigger)
string(JSON cnt GET "${c}" revoked_count)
if(NOT trig STREQUAL "revoke" OR NOT cnt EQUAL 1)
  fail("revoke CRL: trigger ${trig}, ${cnt} entries")
endif()
crl_number_of("${r}")
bxc("again" 1 revoke dev1 --db "${DB}" ${PW} --reason keyCompromise)
expect_error("again" already_revoked)

# the CRL of the crl command lists the serial with the reason
file(MAKE_DIRECTORY "${WORK}/crlout")
bxc("crl" 0 crl --ca "Rev Root" --db "${DB}" ${PW} --out crlout
    --layout certstrap)
one_doc("crl" "${out}" cli-result r)
crl_number_of("${r}")
openssl_run(t crl -in crlout/Rev_Root.crl -noout -text)
if(NOT t MATCHES "Serial Number: ${serial_dev1}[^S]*Key Compromise")
  fail("openssl crl -text: serial ${serial_dev1} with Key Compromise missing:\n${t}")
endif()

# serial as hex with colons, decimal; fingerprint with colons
string(REGEX REPLACE "(..)" "\\1:" colon "${serial_dev2}")
string(REGEX REPLACE ":$" "" colon "${colon}")
bxc("by hex serial" 0 revoke --serial ${colon} --ca "Rev Root" --db "${DB}"
    ${PW} --reason superseded)
one_doc("by hex serial" "${out}" cli-result r)
string(JSON rid GET "${r}" revocation certificate_id)
if(NOT rid EQUAL id_dev2)
  fail("hex serial ${colon} revoked ${rid}, expected ${id_dev2}")
endif()
crl_number_of("${r}")
hex2dec(dec "${serial_dev3}")
# digits only are hex, as XCA shows serials; decimal needs "dec:" (review
# of xca#62: an all-digit serial must not name the other reading silently)
bxc("decimal serial without dec:" 1 revoke --serial ${dec} --ca "Rev Root"
    --db "${DB}" ${PW} --reason cessationOfOperation)
expect_error("decimal serial without dec:" unknown_serial)
bxc("by decimal serial" 0 revoke --serial dec:${dec} --ca "Rev Root"
    --db "${DB}" ${PW} --reason cessationOfOperation)
one_doc("by decimal serial" "${out}" cli-result r)
string(JSON rid GET "${r}" revocation certificate_id)
if(NOT rid EQUAL id_dev3)
  fail("decimal serial ${dec} revoked ${rid}, expected ${id_dev3}")
endif()
crl_number_of("${r}")
bxc("by fingerprint" 0 revoke --fingerprint "${fp_dev4}" --db "${DB}" ${PW}
    --reason affiliationChanged --ca "Rev Root")
one_doc("by fingerprint" "${out}" cli-result r)
string(JSON rid GET "${r}" revocation certificate_id)
if(NOT rid EQUAL id_dev4)
  fail("fingerprint revoked ${rid}, expected ${id_dev4}")
endif()
crl_number_of("${r}")

bxc("crl again" 0 crl --ca "Rev Root" --db "${DB}" ${PW} --out crlout
    --layout certstrap --force)
one_doc("crl again" "${out}" cli-result r)
crl_number_of("${r}")
openssl_run(t crl -in crlout/Rev_Root.crl -noout -text)
foreach(n dev1 dev2 dev3 dev4)
  if(NOT t MATCHES "Serial Number: ${serial_${n}}")
    fail("the CRL does not list ${n} (${serial_${n}}):\n${t}")
  endif()
endforeach()
if(t MATCHES "Serial Number: ${serial_dev5}")
  fail("the CRL lists dev5, which only a --plan run revoked")
endif()

# rule 7: CRL numbers increase over init, revoke and crl
set(prev 0)
foreach(n IN LISTS numbers)
  if(NOT n GREATER prev)
    fail("CRL numbers do not increase: ${numbers}")
  endif()
  set(prev ${n})
endforeach()
if(NOT numbers STREQUAL "1;2;3;4;5;6;7")
  fail("CRL numbers ${numbers}, expected 1..7")
endif()

# --- BTD-211 (g): the invalidity date is not after the revocation date -----
bxc("request dev6" 0 request-cert --db "${DB}" ${PW} --cn dev6)
bxc("sign dev6" 0 sign dev6 --db "${DB}" ${PW} --ca "Rev Root")
time_ahead(t_far 3600)
time_ahead(t_near 120)
time_ago(t_past 86400)
foreach(pair "1 h ahead|${t_far}" "2 min ahead|${t_near}")
  string(REPLACE "|" ";" p "${pair}")
  list(GET p 0 what)
  list(GET p 1 when)
  bxc("invalidity date ${what}" any revoke dev6 --db "${DB}" ${PW}
      --reason keyCompromise --invalidity-date ${when})
  revoked_type(dev6 t)
  if(NOT t STREQUAL "NULL")
    fail("invalidity date ${what} (${when}), after the revocation date: accepted, dev6 revoked (exit ${rc})")
  endif()
  if(NOT rc EQUAL 2)
    fail("invalidity date ${what}: exit code ${rc}, expected 2")
  endif()
  expect_error("invalidity date ${what}" invalid_invalidity_date)
endforeach()
bxc("plan invalidity date ahead" 2 revoke dev6 --db "${DB}" ${PW}
    --reason keyCompromise --invalidity-date ${t_far} --plan)
expect_error("plan invalidity date ahead" invalid_invalidity_date)
bxc("invalidity date in the past" 0 revoke dev6 --db "${DB}" ${PW}
    --reason keyCompromise --invalidity-date ${t_past})
bxc("show dev6" 0 show dev6 --db "${DB}" ${PW} --type certificate)
string(STRIP "${out}" d)
string(JSON inv GET "${d}" revocation invalidity_date)
string(JSON rdate GET "${d}" revocation date)
if(NOT inv STREQUAL t_past)
  fail("dev6: invalidity date ${inv}, expected ${t_past} (revoked ${rdate})")
endif()

# --- a key password that --password does not unlock -----------------------
bxc("request odev" 0 request-cert --db "${DB}" ${PW} --cn odev)
bxc("sign odev" 0 sign odev --db "${DB}" ${PW} --ca "Other Root")
set(ENV{OTHER_KEY_PW} "Other-Key-Pw-42")
fixture("Other Root key with another password" ownpass "Other Root"
    env:OTHER_KEY_PW)
bxc("wrong key password" 1 revoke odev --db "${DB}" ${PW} --reason keyCompromise)
string(STRIP "${err}" e)
string(REGEX REPLACE ".*\n" "" e "${e}")
string(JSON code GET "${e}" code)
if(NOT code MATCHES "password")
  fail("wrong key password: code ${code}")
endif()
revoked_type(odev t)
if(NOT t STREQUAL "NULL")
  fail("odev was revoked although the CA key was not unlocked")
endif()

# --- audit -----------------------------------------------------------------
audit_entries(a)
audit_has("${a}" "\"action\":\"certificate\\.revoke\".*\"channel\":\"cli\".*\"reason\":\"Key Compromise\".*\"result\":\"success\"" "revoke success")
audit_has("${a}" "\"action\":\"certificate\\.revoke\".*\"channel\":\"cli\".*\"error_code\":\"already_revoked\".*\"result\":\"failure\"" "revoke refused")
foreach(trig init revoke command)
  audit_has("${a}" "\"action\":\"crl\\.generate\".*\"channel\":\"cli\".*\"trigger\":\"${trig}\".*\"result\":\"success\"" "crl.generate ${trig}")
endforeach()
# refusals before the service call get a failure entry too (review of xca#62)
foreach(code wrong_issuer unknown_serial invalid_fingerprint ambiguous_reference
    invalid_invalidity_date)
  audit_has("${a}" "\"action\":\"certificate\\.revoke\".*\"channel\":\"cli\".*\"error_code\":\"${code}\".*\"result\":\"failure\"" "refusal ${code}")
endforeach()
audit_has("${a}" "\"action\":\"cli\\.plan\".*\"channel\":\"cli\".*\"command\":\"revoke\"" "plan entry")
audit_has("${a}" "\"action\":\"object\\.export\".*\"channel\":\"cli\".*Rev_Root\\.crl" "CRL file export")
