# bxc-pki bootstrap (BTD-166, bxc-pki PLAN.md 8.2): a lab-like file with
# the three hierarchies ot-rsa, ot-p256 and pqc (root and issuing CA
# each), three profiles and a policy, set up on an empty database in one
# run; every chain verifies with openssl verify, every CA has its empty
# CRL (openssl crl -verify); the first audit entry is bootstrap.apply with
# the SHA-256 of the file. A second run changes nothing and keeps every
# object; --plan writes nothing, also without any password source; a file
# with one more CA creates only that CA; changed CRL settings and a
# changed profile are updates. Elements of later phases are skipped.
# issued_with is recorded and compared (a different one is
# bootstrap_conflict); profiles and policies are assigned to the CA and a
# change of them is an update (assign, unassign). --text prints one line
# per object (kind, bootstrap id, action, database id) and the unchecked
# steps.

include("${LIB}")
include("${CMAKE_CURRENT_LIST_DIR}/cli_bootstrap_lib.cmake")

file(SHA256 "${LAB}" lab_sha)

# --- --plan on a database that does not exist yet ------------------------------
bxc("plan fresh" 0 bootstrap --file "${LAB}" --db "${DB}" --plan)
one_doc("plan fresh" "${out}" cli-result r)
jget(cmd "${r}" command)
jget(plan "${r}" plan)
if(NOT cmd STREQUAL "bootstrap" OR NOT plan)
  fail("plan fresh: command '${cmd}', plan '${plan}':\n${r}")
endif()
if(EXISTS "${DB}")
  fail("plan fresh: --plan created the database")
endif()
bs_actions("${r}" acts)
foreach(ca IN LISTS CAS)
  if(NOT "ca:${ca}=create" IN_LIST acts)
    fail("plan fresh: ${ca} is not planned as create: ${acts}")
  endif()
endforeach()
jlen(nu "${r}" bootstrap unchecked)
if(nu EQUAL 0)
  fail("plan fresh: no unchecked list (a plan never reports a silent all-ok):\n${r}")
endif()

# --text: one line per object and the unchecked steps
bxc("plan fresh text" 0 bootstrap --file "${LAB}" --db "${DB}" --plan --text)
foreach(line "ca ot-rsa-root: create, id -" "ca pqc-issuing: create, id -"
    "profile root-ca: create, version -" "policy lab-names: create, version -"
    "skipped /server: " "unchecked database: ")
  string(FIND "${out}" "${line}" pos)
  if(pos LESS 0)
    fail("plan fresh text: no line '${line}':\n${out}")
  endif()
endforeach()
if(out MATCHES "^{")
  fail("plan fresh text: JSON instead of text:\n${out}")
endif()
# BTD-235: no generic "nothing written" next to the create lines; the plan
# says itself that it wrote nothing
if(out MATCHES "(^|\n)nothing written")
  fail("plan fresh text: generic 'nothing written' next to the bootstrap list:\n${out}")
endif()
string(FIND "${out}" "plan: nothing written" pos)
if(pos LESS 0)
  fail("plan fresh text: no line 'plan: nothing written':\n${out}")
endif()

# --- the run on an empty database ------------------------------------------
# no --password: the database password comes from the file (env:BXC_DB_PW)
bxc("apply lab" 0 bootstrap --file "${LAB}" --db "${DB}")
one_doc("apply lab" "${out}" cli-result r1)
jget(cmd "${r1}" command)
jget(plan "${r1}" plan)
jget(fsha "${r1}" bootstrap file_sha256)
jget(schema "${r1}" bootstrap schema)
if(NOT cmd STREQUAL "bootstrap" OR plan OR NOT fsha STREQUAL "${lab_sha}" OR
   NOT schema STREQUAL "urn:bxc-pki:schema:bootstrap:v1")
  fail("apply lab: command '${cmd}', plan '${plan}', file_sha256 '${fsha}' (expected ${lab_sha}), schema '${schema}'")
endif()
# 6 CAs, 3 profiles, 1 policy; rollover, ocsp, publishers, server,
# enrollment and roles are later phases
bs_counts("apply lab" "${r1}" 10 0 0 6)
bs_skipped("${r1}" skipped)
foreach(e /cas/1/rollover /ocsp /publishers /server /enrollment /roles)
  if(NOT e IN_LIST skipped)
    fail("apply lab: ${e} is not reported as skipped: ${skipped}")
  endif()
endforeach()
bs_actions("${r1}" acts)
foreach(o profile:root-ca profile:issuing-ca profile:tls-server
    policy:lab-names)
  if(NOT "${o}=create" IN_LIST acts)
    fail("apply lab: ${o} not created: ${acts}")
  endif()
endforeach()
result_objects("${r1}" objs)
foreach(t key certificate crl)
  set(n 0)
  foreach(o IN LISTS objs)
    if(o MATCHES "^${t}:")
      math(EXPR n "${n} + 1")
    endif()
  endforeach()
  if(NOT n EQUAL 6)
    fail("apply lab: ${n} objects of type ${t}, expected 6: ${objs}")
  endif()
endforeach()

# every CA: id, type, serial, fingerprint, issuer, CRL number, nextUpdate
foreach(ca IN LISTS CAS)
  bs_entry("${r1}" ca ${ca} e)
  foreach(m action type id name serial fingerprint issuer crl_id crl_number
      next_update)
    jget(v "${e}" ${m})
    if(v STREQUAL "NOTFOUND" OR v STREQUAL "")
      fail("apply lab: ${ca} has no ${m}:\n${e}")
    endif()
    set(${ca}_${m} "${v}")
  endforeach()
  if(NOT ${ca}_action STREQUAL "create" OR
     NOT ${ca}_type STREQUAL "certificate" OR
     NOT ${ca}_crl_number STREQUAL "1" OR
     NOT ${ca}_fingerprint MATCHES "^([0-9A-F][0-9A-F]:)+[0-9A-F][0-9A-F]$")
    fail("apply lab: entry of ${ca}:\n${e}")
  endif()
endforeach()
if(NOT ot-rsa-issuing_issuer MATCHES "^CN=BxC OT RSA Root CA,")
  fail("apply lab: issuer of ot-rsa-issuing '${ot-rsa-issuing_issuer}'")
endif()

# --- openssl: every chain and every CRL ------------------------------------
foreach(ca IN LISTS CAS)
  bxc("show ${ca}" 0 show ${${ca}_id} --type certificate --db "${DB}")
  string(STRIP "${out}" d)
  pem_file("${d}" "${WORK}/${ca}.pem")
  set(${ca}_doc "${d}")
  bxc("show crl ${ca}" 0 show ${${ca}_crl_id} --type crl --db "${DB}")
  string(STRIP "${out}" d)
  pem_file("${d}" "${WORK}/${ca}.crl.pem")
endforeach()
foreach(h ot-rsa ot-p256 pqc)
  file(READ "${WORK}/${h}-root.pem" rp)
  file(READ "${WORK}/${h}-issuing.pem" ip)
  file(WRITE "${WORK}/${h}-chain.pem" "${rp}${ip}")
  openssl_run(v verify -x509_strict -CAfile "${WORK}/${h}-root.pem"
      "${WORK}/${h}-root.pem")
  openssl_run(v verify -x509_strict -CAfile "${WORK}/${h}-root.pem"
      "${WORK}/${h}-issuing.pem")
  if(NOT v MATCHES ": OK")
    fail("openssl verify ${h}-issuing: ${v}")
  endif()
  foreach(level root issuing)
    openssl_run(v crl -in "${WORK}/${h}-${level}.crl.pem" -noout
        -CAfile "${WORK}/${h}-chain.pem")
    if(NOT v MATCHES "verify OK")
      fail("openssl crl -verify ${h}-${level}: ${v}")
    endif()
    openssl_run(v crl -in "${WORK}/${h}-${level}.crl.pem" -noout -text)
    if(v MATCHES "Serial Number")
      fail("the CRL of ${h}-${level} is not empty: ${v}")
    endif()
  endforeach()
endforeach()
# path_len, name constraints, the RDN order of the dn list, the CDP of
# the parent's CRL in the issuing CA, key usage
set(d "${ot-rsa-issuing_doc}")
extension("${d}" basicConstraints bc)
extension("${d}" nameConstraints nc)
extension("${d}" crlDistributionPoints cdp)
extension("${d}" keyUsage ku)
jget(subj "${d}" subject rfc4514)
if(NOT bc MATCHES "pathlen:0" OR NOT nc MATCHES "lab\\.example\\.org" OR
   NOT nc MATCHES "192\\.168\\.0\\.0" OR NOT nc_critical OR
   NOT cdp MATCHES "ot-rsa-root\\.crl" OR NOT ku MATCHES "Certificate Sign" OR
   NOT subj MATCHES "^CN=BxC OT RSA Issuing CA,OU=.*,O=BxC Security,C=DE,DC=example,DC=org$")
  fail("ot-rsa-issuing: basicConstraints '${bc}', nameConstraints '${nc}' (critical ${nc_critical}), CDP '${cdp}', keyUsage '${ku}', subject '${subj}'")
endif()
extension("${ot-rsa-root_doc}" basicConstraints bc)
if(bc MATCHES "pathlen")
  fail("ot-rsa-root has a path length it was not given: ${bc}")
endif()

# CRL settings through CrlPolicy::store: settings row and crlDays
sql("pqc-root crlpolicy" "SELECT value FROM settings WHERE key_='crlpolicy_${pqc-root_id}'")
if(NOT out MATCHES "\"validity\":\"P30D\"" OR NOT out MATCHES "\"size_budget\":32768")
  fail("pqc-root: CRL settings row '${out}'")
endif()
sql("pqc-root crlDays" "SELECT crlDays FROM authority WHERE item=${pqc-root_id}")
if(NOT out MATCHES "^30")
  fail("pqc-root: crlDays '${out}', expected 30")
endif()
# the mapping of the bootstrap ids
sql("mapping rows" "SELECT COUNT(*) FROM settings WHERE key_ LIKE 'bootstrap_%'")
if(NOT out MATCHES "^10")
  fail("expected 10 bootstrap mapping rows, got '${out}'")
endif()
# profiles and policies assigned per CA (BTD-167 assignments); issued_with
# is recorded in the mapping row, never assigned
function(assigned ca kind want)
  sql("${ca} ${kind}s" "SELECT name FROM assignments WHERE owner_type='ca' AND owner='${${ca}_id}' AND kind='${kind}' ORDER BY name")
  string(STRIP "${out}" got)
  string(REPLACE "\n" "," got "${got}")
  if(NOT got STREQUAL "${want}")
    fail("${ca}: ${kind}s assigned '${got}', expected '${want}'")
  endif()
endfunction()
foreach(ca ot-rsa-root ot-p256-root pqc-root)
  assigned(${ca} profile "issuing-ca")
  assigned(${ca} policy "")
endforeach()
assigned(ot-rsa-issuing profile "tls-server")
assigned(ot-p256-issuing profile "tls-server")
assigned(pqc-issuing profile "")
foreach(ca ot-rsa-issuing ot-p256-issuing pqc-issuing)
  assigned(${ca} policy "lab-names")
endforeach()
bs_entry("${r1}" ca ot-rsa-issuing e)
jget(iw "${e}" issued_with)
string(JSON pr ERROR_VARIABLE je GET "${e}" profiles)
string(JSON po ERROR_VARIABLE je GET "${e}" policies)
string(JSON hasold ERROR_VARIABLE je GET "${e}" profile)
if(NOT iw STREQUAL "issuing-ca" OR NOT pr MATCHES "\"tls-server\"" OR
   NOT po MATCHES "\"lab-names\"" OR NOT hasold MATCHES "NOTFOUND")
  fail("apply lab: ot-rsa-issuing issued_with '${iw}', profiles '${pr}', policies '${po}', profile '${hasold}':\n${e}")
endif()
sql("issued_with row" "SELECT value FROM settings WHERE value LIKE '%\"bootstrap_id\":\"ot-rsa-issuing\"%'")
if(NOT out MATCHES "\"issued_with\":\"issuing-ca\"")
  fail("ot-rsa-issuing: issued_with not recorded in the mapping row: '${out}'")
endif()

# --- audit: seq 1 is bootstrap.apply with the file hash ----------------------
audit_entries(a)
split_lines("${a}" alines)
list(GET alines 0 first)
string(REPLACE "@SEMI@" ";" first "${first}")
jget(seq "${first}" seq)
jget(act "${first}" action)
jget(fs "${first}" params file_sha256)
jget(sch "${first}" params schema)
jget(cr "${first}" params created)
if(NOT seq STREQUAL "1" OR NOT act STREQUAL "bootstrap.apply" OR
   NOT fs STREQUAL "${lab_sha}" OR NOT cr STREQUAL "10" OR
   NOT sch STREQUAL "urn:bxc-pki:schema:bootstrap:v1")
  fail("the first audit entry is not bootstrap.apply with the file hash:\n${first}")
endif()
audit_has("${a}" "\"action\":\"ca\\.crl_settings\".*\"crl_validity\":\"P30D\"" "crl settings")
audit_has("${a}" "\"action\":\"profile\\.create\"" "profile.create")
audit_has("${a}" "\"action\":\"policy\\.create\"" "policy.create")
audit_has("${a}" "\"action\":\"profile\\.assign\"" "profile.assign")
audit_has("${a}" "\"action\":\"policy\\.assign\"" "policy.assign")
audit_has("${a}" "\"action\":\"crl\\.generate\"" "crl.generate")
audit_count(n_audit)

# --- second run: nothing changes ---------------------------------------------
db_state(before)
bxc("apply lab again" 0 bootstrap --file "${LAB}" --db "${DB}")
one_doc("apply lab again" "${out}" cli-result r2)
bs_counts("apply lab again" "${r2}" 0 10 0 6)
jlen(no "${r2}" objects)
if(NOT no EQUAL 0)
  fail("apply lab again: objects written:\n${r2}")
endif()
foreach(ca IN LISTS CAS)
  bs_entry("${r2}" ca ${ca} e)
  foreach(m action id serial fingerprint crl_number next_update)
    jget(v "${e}" ${m})
    set(want "${${ca}_${m}}")
    if(m STREQUAL "action")
      set(want keep)
    endif()
    if(NOT v STREQUAL "${want}")
      fail("apply lab again: ${ca} ${m} '${v}', expected '${want}':\n${e}")
    endif()
  endforeach()
endforeach()
db_state(after)
if(NOT before STREQUAL after)
  fail("the second run changed the database:\nbefore:\n${before}\nafter:\n${after}")
endif()
audit_count(n2)
math(EXPR want "${n_audit} + 1")
if(NOT n2 EQUAL want)
  fail("the second run wrote ${n2} audit entries in all, expected ${want}")
endif()
# the export signs a checkpoint after it: the entry seq ${n2} is the run's
audit_entries(a)
split_lines("${a}" alines)
set(last "")
foreach(line IN LISTS alines)
  string(REPLACE "@SEMI@" ";" line "${line}")
  jget(s "${line}" seq)
  if(s STREQUAL "${n2}")
    set(last "${line}")
  endif()
endforeach()
jget(act "${last}" action)
jget(cr "${last}" params created)
jget(kp "${last}" params kept)
if(NOT act STREQUAL "bootstrap.apply" OR NOT cr STREQUAL "0" OR NOT kp STREQUAL "10")
  fail("the second run: last audit entry is not bootstrap.apply with zero counts:\n${last}")
endif()

# --- --plan on the database, without any password source ---------------------
string(JSON plus SET "${lab}" cas 6
  "{\"id\": \"extra-root\", \"cn\": \"BxC Extra Root CA\", \"key\": \"ec-p256\", \"validity\": \"P5Y\", \"crl\": {\"validity\": \"P2D\"}}")
string(JSON plus SET "${plus}" policies 1 "\"policies-extra/\"")
bs_write(lab-plus.json "${plus}")
set(PLUS "${file}")
unset(ENV{BXC_DB_PW})
file(SHA256 "${DB}" h1)
bxc("plan lab" 0 bootstrap --file "${LAB}" --db "${DB}" --plan)
one_doc("plan lab" "${out}" cli-result p1)
bs_counts("plan lab" "${p1}" 0 10 0 6)
jlen(nu "${p1}" bootstrap unchecked)
string(JSON uc GET "${p1}" bootstrap unchecked)
if(nu EQUAL 0 OR NOT uc MATCHES "ot-rsa-root")
  fail("plan lab: unchecked does not name the private key of the kept CAs:\n${p1}")
endif()
bxc("plan lab-plus" 0 bootstrap --file "${PLUS}" --db "${DB}" --plan)
one_doc("plan lab-plus" "${out}" cli-result p2)
bs_counts("plan lab-plus" "${p2}" 2 10 0 6)
bs_entry("${p2}" ca extra-root e)
jget(act "${e}" action)
string(JSON id TYPE "${e}" id)
if(NOT act STREQUAL "create" OR NOT id STREQUAL "NULL")
  fail("plan lab-plus: extra-root '${act}' id '${id}':\n${e}")
endif()
file(SHA256 "${DB}" h2)
if(NOT h1 STREQUAL h2)
  fail("--plan changed the database file (${h1} -> ${h2})")
endif()
set(ENV{BXC_DB_PW} "${DB_PW}")

# --- a file with one more CA creates only that CA ------------------------------
count_items(certificate nc1)
bxc("apply lab-plus" 0 bootstrap --file "${PLUS}" --db "${DB}")
one_doc("apply lab-plus" "${out}" cli-result r3)
bs_counts("apply lab-plus" "${r3}" 2 10 0 6)
bs_actions("${r3}" acts)
if(NOT "ca:extra-root=create" IN_LIST acts OR
   NOT "policy:web-names=create" IN_LIST acts)
  fail("apply lab-plus: ${acts}")
endif()
count_items(certificate nc2)
math(EXPR want "${nc1} + 1")
if(NOT nc2 EQUAL want)
  fail("apply lab-plus: ${nc2} certificates, expected ${want}")
endif()

# --- changed CRL settings and a changed profile are updates --------------------
string(JSON upd SET "${plus}" cas 2 crl validity "\"P14D\"")
bs_write(lab-update.json "${upd}")
set(UPD "${file}")
file(READ "${BS}/profiles/tls-server.json" prof)
string(JSON prof SET "${prof}" description "\"TLS server certificates, second version (BTD-166 test)\"")
file(WRITE "${BS}/profiles/tls-server.json" "${prof}\n")
bxc("apply lab-update" 0 bootstrap --file "${UPD}" --db "${DB}")
one_doc("apply lab-update" "${out}" cli-result r4)
bs_counts("apply lab-update" "${r4}" 0 10 2 6)
bs_entry("${r4}" ca ot-p256-root e)
jget(act "${e}" action)
string(JSON ch ERROR_VARIABLE je GET "${e}" changed)
if(NOT act STREQUAL "update" OR NOT ch MATCHES "crl")
  fail("apply lab-update: ot-p256-root '${act}', changed '${ch}':\n${e}")
endif()
bs_entry("${r4}" profile tls-server e)
jget(act "${e}" action)
jget(ver "${e}" version)
if(NOT act STREQUAL "update" OR NOT ver STREQUAL "2")
  fail("apply lab-update: tls-server '${act}' version '${ver}':\n${e}")
endif()
count_items(certificate nc3)
if(NOT nc3 EQUAL nc2)
  fail("apply lab-update: a certificate was issued (${nc2} -> ${nc3})")
endif()
sql("ot-p256-root crlpolicy" "SELECT value FROM settings WHERE key_='crlpolicy_${ot-p256-root_id}'")
if(NOT out MATCHES "\"validity\":\"P14D\"")
  fail("ot-p256-root: CRL settings not updated: '${out}'")
endif()
audit_entries(a)
audit_has("${a}" "\"action\":\"ca\\.crl_settings\".*\"crl_validity\":\"P14D\"" "updated crl settings")
audit_has("${a}" "\"action\":\"profile\\.update\".*\"version\":2" "profile.update")
# and once more: everything kept
bxc("apply lab-update again" 0 bootstrap --file "${UPD}" --db "${DB}")
one_doc("apply lab-update again" "${out}" cli-result r5)
bs_counts("apply lab-update again" "${r5}" 0 12 0 6)

# --- changed profiles and policies are updates: unassign, assign ----------------
# ot-p256-issuing (/cas/3): tls-server and lab-names were assigned by
# bootstrap and are taken back; root-ca is assigned instead
string(JSON asg SET "${upd}" cas 3 profiles [=[["root-ca"]]=])
string(JSON asg SET "${asg}" cas 3 policies "[]")
bs_write(lab-assign.json "${asg}")
set(ASG "${file}")
bxc("apply lab-assign" 0 bootstrap --file "${ASG}" --db "${DB}")
one_doc("apply lab-assign" "${out}" cli-result r6)
bs_counts("apply lab-assign" "${r6}" 0 11 1 6)
bs_entry("${r6}" ca ot-p256-issuing e)
jget(act "${e}" action)
string(JSON ch ERROR_VARIABLE je GET "${e}" changed)
if(NOT act STREQUAL "update" OR NOT ch MATCHES "\"profiles\"" OR
   NOT ch MATCHES "\"policies\"")
  fail("apply lab-assign: ot-p256-issuing '${act}', changed '${ch}':\n${e}")
endif()
assigned(ot-p256-issuing profile "root-ca")
assigned(ot-p256-issuing policy "")
assigned(ot-rsa-issuing profile "tls-server")
assigned(ot-rsa-issuing policy "lab-names")
count_items(certificate nc4)
if(NOT nc4 EQUAL nc2)
  fail("apply lab-assign: a certificate was issued (${nc2} -> ${nc4})")
endif()
audit_entries(a)
audit_has("${a}" "\"action\":\"profile\.unassign\".*\"name\":\"tls-server\"" "profile.unassign")
audit_has("${a}" "\"action\":\"policy\.unassign\".*\"name\":\"lab-names\"" "policy.unassign")
bxc("apply lab-assign again" 0 bootstrap --file "${ASG}" --db "${DB}")
one_doc("apply lab-assign again" "${out}" cli-result r7)
bs_counts("apply lab-assign again" "${r7}" 0 12 0 6)

# --- a different issued_with is bootstrap_conflict (the CA certificate was
# issued with the recorded one) ---------------------------------------------------
string(JSON iw SET "${asg}" cas 3 issued_with [=["root-ca"]=])
bs_write(lab-issued-with.json "${iw}")
db_state(before)
bxc("issued_with changed" 1 bootstrap --file "${file}" --db "${DB}")
expect_error("issued_with changed" bootstrap_conflict)
string(FIND "${detail}" "/cas/3/issued_with: " pos)
if(NOT pos EQUAL 0 OR NOT detail MATCHES "ot-p256-issuing" OR
   NOT detail MATCHES "issuing-ca" OR NOT detail MATCHES "root-ca")
  fail("issued_with changed: detail '${detail}'")
endif()
db_state(after)
if(NOT before STREQUAL after)
  fail("issued_with changed: the database changed:\n${before}\n---\n${after}")
endif()
bxc("issued_with changed, plan" 0 bootstrap --file "${file}" --db "${DB}" --plan)
one_doc("issued_with changed, plan" "${out}" cli-result r)
bs_entry("${r}" ca ot-p256-issuing e)
jget(act "${e}" action)
jget(code "${e}" error code)
if(NOT act STREQUAL "error" OR NOT code STREQUAL "bootstrap_conflict")
  fail("issued_with changed, plan: '${act}' '${code}':\n${e}")
endif()

# --- --text of a real run: every object kept, with its database id --------------
bxc("apply text" 0 bootstrap --file "${ASG}" --db "${DB}" --text)
if(out MATCHES "^{")
  fail("apply text: JSON instead of text:\n${out}")
endif()
foreach(line "ca ot-rsa-root: keep, id ${ot-rsa-root_id}"
    "ca pqc-issuing: keep, id ${pqc-issuing_id}"
    "profile tls-server: keep, version 2" "policy lab-names: keep, version 1"
    "skipped /cas/1/rollover: ")
  string(FIND "${out}" "${line}" pos)
  if(pos LESS 0)
    fail("apply text: no line '${line}':\n${out}")
  endif()
endforeach()
if(out MATCHES "unchecked")
  fail("apply text: unchecked steps without --plan:\n${out}")
endif()
if(out MATCHES "nothing written")
  fail("apply text: 'nothing written' next to the bootstrap list (BTD-235):\n${out}")
endif()
message(STATUS "bxc-pki bootstrap ok")
